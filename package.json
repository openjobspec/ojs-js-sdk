{
  "name": "@openjobspec/sdk",
  "version": "0.5.0",
  "description": "Official Open Job Spec SDK for JavaScript and TypeScript",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./serverless": {
      "import": {
        "types": "./dist/esm/serverless/index.d.ts",
        "default": "./dist/esm/serverless/index.js"
      },
      "require": {
        "types": "./dist/cjs/serverless/index.d.cts",
        "default": "./dist/cjs/serverless/index.js"
      }
    },
    "./serverless/cloudflare": {
      "import": {
        "types": "./dist/esm/serverless/cloudflare.d.ts",
        "default": "./dist/esm/serverless/cloudflare.js"
      },
      "require": {
        "types": "./dist/cjs/serverless/cloudflare.d.cts",
        "default": "./dist/cjs/serverless/cloudflare.js"
      }
    },
    "./serverless/vercel": {
      "import": {
        "types": "./dist/esm/serverless/vercel.d.ts",
        "default": "./dist/esm/serverless/vercel.js"
      },
      "require": {
        "types": "./dist/cjs/serverless/vercel.d.cts",
        "default": "./dist/cjs/serverless/vercel.js"
      }
    },
    "./serverless/lambda": {
      "import": {
        "types": "./dist/esm/serverless/lambda.d.ts",
        "default": "./dist/esm/serverless/lambda.js"
      },
      "require": {
        "types": "./dist/cjs/serverless/lambda.d.cts",
        "default": "./dist/cjs/serverless/lambda.js"
      }
    },
    "./middleware": {
      "import": {
        "types": "./dist/esm/middleware/index.d.ts",
        "default": "./dist/esm/middleware/index.js"
      },
      "require": {
        "types": "./dist/cjs/middleware/index.d.cts",
        "default": "./dist/cjs/middleware/index.js"
      }
    },
    "./ml": {
      "import": {
        "types": "./dist/esm/ml.d.ts",
        "default": "./dist/esm/ml.js"
      },
      "require": {
        "types": "./dist/cjs/ml.d.cts",
        "default": "./dist/cjs/ml.js"
      }
    },
    "./encryption": {
      "import": {
        "types": "./dist/esm/encryption.d.ts",
        "default": "./dist/esm/encryption.js"
      },
      "require": {
        "types": "./dist/cjs/encryption.d.cts",
        "default": "./dist/cjs/encryption.js"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/esm/otel.d.ts",
        "default": "./dist/esm/otel.js"
      },
      "require": {
        "types": "./dist/cjs/otel.d.cts",
        "default": "./dist/cjs/otel.js"
      }
    },
    "./subscribe": {
      "import": {
        "types": "./dist/esm/subscribe.d.ts",
        "default": "./dist/esm/subscribe.js"
      },
      "require": {
        "types": "./dist/cjs/subscribe.d.cts",
        "default": "./dist/cjs/subscribe.js"
      }
    },
    "./agent": {
      "import": {
        "types": "./dist/esm/agent/index.d.ts",
        "default": "./dist/esm/agent/index.js"
      },
      "require": {
        "types": "./dist/cjs/agent/index.d.cts",
        "default": "./dist/cjs/agent/index.js"
      }
    },
    "./attest": {
      "import": {
        "types": "./dist/esm/attest/index.d.ts",
        "default": "./dist/esm/attest/index.js"
      },
      "require": {
        "types": "./dist/cjs/attest/index.d.cts",
        "default": "./dist/cjs/attest/index.js"
      }
    },
    "./recorder": {
      "import": {
        "types": "./dist/esm/recorder/index.d.ts",
        "default": "./dist/esm/recorder/index.js"
      },
      "require": {
        "types": "./dist/cjs/recorder/index.d.cts",
        "default": "./dist/cjs/recorder/index.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "serverless": [
        "./dist/esm/serverless/index.d.ts"
      ],
      "serverless/cloudflare": [
        "./dist/esm/serverless/cloudflare.d.ts"
      ],
      "serverless/vercel": [
        "./dist/esm/serverless/vercel.d.ts"
      ],
      "serverless/lambda": [
        "./dist/esm/serverless/lambda.d.ts"
      ],
      "middleware": [
        "./dist/esm/middleware/index.d.ts"
      ],
      "ml": [
        "./dist/esm/ml.d.ts"
      ],
      "encryption": [
        "./dist/esm/encryption.d.ts"
      ],
      "otel": [
        "./dist/esm/otel.d.ts"
      ],
      "subscribe": [
        "./dist/esm/subscribe.d.ts"
      ],
      "agent": [
        "./dist/esm/agent/index.d.ts"
      ],
      "attest": [
        "./dist/esm/attest/index.d.ts"
      ],
      "recorder": [
        "./dist/esm/recorder/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/build-cjs-declarations.mjs && node -e \"fs=require('fs');pkg=JSON.parse(fs.readFileSync('package.json'));fs.writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc -p tsconfig.type-tests.json",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "bench": "vitest bench",
    "lint": "tsc --noEmit && eslint src/",
    "lint:fix": "eslint src/ --fix",
    "size": "size-limit",
    "docs": "typedoc --out docs src/index.ts",
    "attw": "attw --pack",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "^10.0.1",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@opentelemetry/api": "^1.9.0",
    "@size-limit/file": "^12.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.0.2",
    "fast-check": "^4.5.3",
    "size-limit": "^12.0.0",
    "typedoc": "^0.27.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@opentelemetry/api": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@grpc/grpc-js": {
      "optional": true
    },
    "@grpc/proto-loader": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openjobspec/ojs-js-sdk"
  },
  "keywords": [
    "openjobspec",
    "ojs",
    "job",
    "queue",
    "worker",
    "background-jobs",
    "task-queue"
  ],
  "size-limit": [
    {
      "path": "dist/esm/index.js",
      "limit": "15 kB"
    }
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
